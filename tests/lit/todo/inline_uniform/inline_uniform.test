# TODO feature: inline_uniform
# An inline uniform block is indistinguishable from a UBO in SPIR-V (both are StorageClass
# Uniform + Block), so the descriptor type cannot be recovered from the module. Binding
# one as VK_DESCRIPTOR_TYPE_INLINE_UNIFORM_BLOCK also needs VK_EXT_inline_uniform_block,
# which reports maxInlineUniformBlockSize=0 on the RADV devices this suite runs on, so
# the path cannot be validated here. It stays XFAIL until a device that supports the
# extension is available.
# REQUIRES: vulkan, gpu, corpus, glslang
# XFAIL: *
# RUN: %csrun %repo/tests/lit/Inputs/todo/inline_uniform.yaml --backend vulkan --no-show --format json --vendor-counters off --no-benchmark | grep -qi "inline uniform"
