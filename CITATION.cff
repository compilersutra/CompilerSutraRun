cff-version: 1.2.0
title: "CompilerSutraRun (csrun): A Reusable Execution and Validation Harness for Cross-API GPU Workloads"
message: "If you use CompilerSutraRun, please cite it as below."
type: software
authors:
  - family-names: Tiwari
    given-names: Aditya
    email: aditya.tiwari@compilersutra.com
