{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Ninja Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CSRUN_ENABLE_VULKAN": "ON",
        "CSRUN_ENABLE_OPENGL": "ON",
        "CSRUN_ENABLE_OPENCL": "ON",
        "CSRUN_ENABLE_HIP": "ON",
        "CSRUN_ENABLE_CUDA": "OFF",
        "CSRUN_ENABLE_D3D12": "OFF",
        "CSRUN_ENABLE_TESTS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Ninja Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CSRUN_ENABLE_TESTS": "ON"
      }
    },
    {
      "name": "ci",
      "displayName": "CI (no OpenCL/HIP)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-ci",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CSRUN_ENABLE_VULKAN": "ON",
        "CSRUN_ENABLE_OPENGL": "ON",
        "CSRUN_ENABLE_OPENCL": "OFF",
        "CSRUN_ENABLE_HIP": "OFF",
        "CSRUN_ENABLE_CUDA": "OFF",
        "CSRUN_ENABLE_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "ci",
      "configurePreset": "ci"
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
